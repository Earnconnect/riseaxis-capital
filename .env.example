# ── Client (browser) — safe to expose, must start with VITE_ ──
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_OPENAI_API_KEY=your_openai_api_key
VITE_APP_URL=http://localhost:5173

# ── Server only (Vercel serverless: api/send-email.js) ──────────
# These are read at runtime by the email function. Set them in
# Vercel → Project → Settings → Environment Variables.
# Do NOT add the VITE_ prefix — that would leak them to the browser.
RESEND_API_KEY=your_resend_api_key
# Verified sender in Resend. Until you verify riseaxiscapital.info,
# Resend only delivers from onboarding@resend.dev to your own address.
EMAIL_FROM=RiseAxis Capital <grants@riseaxiscapital.info>
# Used to build links inside emails (no trailing slash)
APP_URL=https://riseaxiscapital.info
